---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work'))
	.filter((project) => project.data.img !== '/assets/backgrounds/bg-main-light.svg')
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
	title="Portfolio & Projects | Tom Eagle - Web Developer & Shopify Specialist"
	description="Explore my portfolio of web development and Shopify projects. View case studies of custom e-commerce solutions, React applications, and frontend development work."
	image="/assets/profile-portrait-2026.png"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="A selection of Shopify and frontend delivery across new builds, CRO improvements, and long-term theme support."
				align="start"
			/>
			<p class="work-intro">
				Each project highlights the challenge, the implementation approach, and the outcomes delivered for ecommerce teams.
			</p>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li class="listing-item">
							<PortfolioPreview project={project} />
							<p class="engagement">
								<span class:list={['badge', { direct: project.id === 'getdopa' }]}>
									{project.id === 'getdopa' ? 'Direct with merchant' : 'Contracted via agency'}
								</span>
							</p>
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.work-intro {
		max-width: 65ch;
		color: var(--gray-300);
	}

	.listing-item {
		display: grid;
		gap: 0.5rem;
	}

	.engagement {
		margin: 0;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.6rem;
		border-radius: 0.5rem;
		font-size: var(--text-sm);
		color: var(--gray-200);
		border: 1px solid var(--gray-700);
		background: color-mix(in srgb, var(--gray-999) 92%, transparent);
	}

	.badge.direct {
		border-color: color-mix(in srgb, var(--accent-regular) 55%, var(--gray-700));
		background: color-mix(in srgb, var(--gray-999) 88%, var(--accent-regular) 12%);
	}
</style>
