---
import { type CollectionEntry, getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import { render } from 'astro:content';
import CallToAction from '../../components/CallToAction.astro';

interface Props {
    entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
    const work = (await getCollection('work')).filter(
        (entry) => entry.data.img !== '/assets/backgrounds/bg-main-light.svg'
    );
    return work.map((entry) => ({
        params: { slug: entry.id },
        props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const galleryImages =
    entry.data.gallery && entry.data.gallery.length > 0
        ? entry.data.gallery
        : [entry.data.img];
const hasMultipleSlides = galleryImages.length > 1;
---

<BaseLayout 
	title={`${entry.data.title} - Project Case Study | Tom Eagle`}
	description={entry.data.description}
	image={entry.data.img as string}
>
    <div class="stack gap-8">
        <div class="stack gap-5">
            <header>
                <div class="wrapper project-header">
                    <a class="back-link" href="/work/">
                        <Icon icon="arrow-left" /> Back to Work
                    </a>
                    <div class="header-main">
                        <div class="header-left">
                            <h1>{entry.data.title}</h1>
                            <div class="tags">
                                {entry.data.tags.map((t) => <Pill>{t}</Pill>)}
                            </div>
                        </div>
                        <div class="summary">
                            <p class="description">{entry.data.description}</p>
                            {entry.data.url && (
                                <CallToAction href={entry.data.url}>View the live site</CallToAction>
                            )}
                        </div>
                    </div>
                </div>
            </header>
            <main class="wrapper">
                <div class="stack gap-8 content">
                    {
                        galleryImages.length > 0 && (
                            <div
                                class="gallery-carousel"
                                data-gallery-carousel
                                data-draggable={hasMultipleSlides ? 'true' : 'false'}
                            >
                                <div class="carousel-viewport">
                                    <div class="carousel-track">
                                        {
                                            galleryImages.map((imageSrc, index) => (
                                                <div class="carousel-slide">
                                                    <img
                                                        src={imageSrc}
                                                        alt={entry.data.img_alt || `${entry.data.title} screenshot ${index + 1}`}
                                                        draggable="false"
                                                    />
                                                </div>
                                            ))
                                        }
                                    </div>
                                </div>
                                {
                                    hasMultipleSlides && (
                                        <div class="carousel-pagination" aria-label="Project image pagination">
                                            {
                                                galleryImages.map((_, index) => (
                                                    <button
                                                        class="dot"
                                                        type="button"
                                                        data-index={index}
                                                        aria-label={`Show image ${index + 1}`}
                                                        aria-current={index === 0 ? 'true' : 'false'}
                                                    />
                                                ))
                                            }
                                        </div>
                                    )
                                }
                            </div>
                        )
                    }
                    <div class="content">
                        <Content />
                    </div>
                </div>
            </main>
        </div>
        <ContactCTA />
    </div>
</BaseLayout>

<script>
    class GalleryCarousel {
        private root: HTMLElement;
        private viewport: HTMLElement;
        private track: HTMLElement;
        private dots: HTMLButtonElement[];
        private currentIndex = 0;
        private slideCount = 0;
        private isDragging = false;
        private startX = 0;
        private dragOffset = 0;
        private readonly dragThreshold = 48;

        constructor(root: HTMLElement) {
            this.root = root;
            this.viewport = this.root.querySelector('.carousel-viewport') as HTMLElement;
            this.track = this.root.querySelector('.carousel-track') as HTMLElement;
            this.dots = Array.from(this.root.querySelectorAll('.dot')) as HTMLButtonElement[];
            this.slideCount = this.track.children.length;

            this.dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    const index = Number(dot.dataset.index || '0');
                    this.goTo(index);
                });
            });

            if (this.root.dataset.draggable !== 'true' || this.slideCount < 2) return;

            this.viewport.addEventListener('pointerdown', this.onPointerDown);
            this.viewport.addEventListener('pointermove', this.onPointerMove);
            this.viewport.addEventListener('pointerup', this.onPointerUp);
            this.viewport.addEventListener('pointercancel', this.onPointerUp);
            this.viewport.addEventListener('pointerleave', this.onPointerUp);

            this.viewport.addEventListener(
                'wheel',
                (event) => {
                    if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
                    event.preventDefault();
                    if (event.deltaX > 0) this.goTo(this.currentIndex + 1);
                    else this.goTo(this.currentIndex - 1);
                },
                { passive: false }
            );

            window.addEventListener('resize', () => this.setPosition(0, false));
        }

        private onPointerDown = (event: PointerEvent) => {
            if (event.button !== 0) return;
            this.isDragging = true;
            this.startX = event.clientX;
            this.dragOffset = 0;
            this.viewport.setPointerCapture(event.pointerId);
            this.viewport.classList.add('is-dragging');
            this.setPosition(0, false);
        };

        private onPointerMove = (event: PointerEvent) => {
            if (!this.isDragging) return;
            this.dragOffset = event.clientX - this.startX;
            this.setPosition(this.dragOffset, false);
        };

        private onPointerUp = (event: PointerEvent) => {
            if (!this.isDragging) return;
            this.isDragging = false;
            this.viewport.classList.remove('is-dragging');
            if (this.viewport.hasPointerCapture(event.pointerId)) {
                this.viewport.releasePointerCapture(event.pointerId);
            }

            if (this.dragOffset < -this.dragThreshold) this.goTo(this.currentIndex + 1);
            else if (this.dragOffset > this.dragThreshold) this.goTo(this.currentIndex - 1);
            else this.goTo(this.currentIndex);

            this.dragOffset = 0;
        };

        goTo(index: number, animate = true) {
            this.currentIndex = Math.max(0, Math.min(index, this.slideCount - 1));
            this.setPosition(0, animate);
            this.dots.forEach((dot, idx) => {
                dot.setAttribute('aria-current', idx === this.currentIndex ? 'true' : 'false');
            });
        }

        private setPosition(offsetPx: number, animate: boolean) {
            this.track.style.transition = animate ? 'transform 0.35s ease' : 'none';
            const slideWidth = this.viewport.clientWidth;
            const base = -this.currentIndex * slideWidth;
            this.track.style.transform = `translateX(${base + offsetPx}px)`;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-gallery-carousel]').forEach((root) => {
            new GalleryCarousel(root as HTMLElement);
        });
    });
</script>

<style>
    header {
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--gray-800);
    }

    .project-header {
        display: grid;
        gap: 0.65rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--gray-400);
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .header-main {
        display: grid;
        gap: 0.85rem;
    }

    .header-left {
        display: grid;
        gap: 0.5rem;
    }

    .header-left h1 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.05;
        color: var(--gray-0);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .description {
        font-size: var(--text-sm);
        max-width: 54ch;
        margin-bottom: 0.65rem;
        color: var(--gray-300);
    }

    .summary {
        max-width: 54ch;
    }

    .summary :global(.button-pill) {
        font-size: var(--text-sm);
        padding: 0.65rem 1rem;
    }

    .gallery-carousel {
        border: 1px solid var(--gray-800);
        border-radius: 1rem;
        overflow: hidden;
        background: color-mix(in srgb, var(--gray-999) 92%, transparent);
        box-shadow: var(--shadow-sm);
    }

    .carousel-viewport {
        overflow: hidden;
        cursor: grab;
        touch-action: pan-y pinch-zoom;
        user-select: none;
    }

    .carousel-viewport.is-dragging {
        cursor: grabbing;
    }

    .carousel-track {
        display: flex;
        transition: transform 0.35s ease;
        will-change: transform;
    }

    .carousel-slide {
        min-width: 100%;
        padding: 0.65rem;
    }

    .carousel-slide img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: 0.8rem;
        border: 1px solid color-mix(in srgb, var(--gray-700) 45%, transparent);
        display: block;
        pointer-events: none;
    }

    .carousel-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 0.75rem 0.85rem;
    }

    .dot {
        width: 0.7rem;
        height: 0.7rem;
        border: 1px solid color-mix(in srgb, var(--gray-600) 70%, transparent);
        border-radius: 999rem;
        background: var(--gray-600);
        cursor: pointer;
        padding: 0;
        transition:
            transform var(--theme-transition),
            background-color var(--theme-transition),
            border-color var(--theme-transition);
    }

    .dot[aria-current='true'] {
        width: 1.35rem;
        background: var(--accent-regular);
        border-color: color-mix(in srgb, var(--accent-regular) 70%, var(--gray-700));
    }

    .content {
        max-width: 65ch;
        margin-inline: auto;
    }

    .content > :global(* + *) {
        margin-top: 1rem;
    }

    .content :global(h2) {
        font-size: var(--text-xl);
        margin: 1.25rem 0 0.75rem;
        color: var(--gray-100);
    }

    .content :global(h3) {
        font-size: var(--text-lg);
        margin: 1rem 0 0.5rem;
        color: var(--gray-100);
    }

    .content :global(h4),
    .content :global(h5) {
        font-size: var(--text-md);
        margin: 0.85rem 0 0.4rem;
        color: var(--gray-200);
    }

    .content :global(img) {
        border-radius: 1.5rem;
        box-shadow: var(--shadow-sm);
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
    }

    .content :global(blockquote) {
        font-size: var(--text-lg);
        font-family: var(--font-brand);
        font-weight: 600;
        line-height: 1.1;
        padding-inline-start: 1.5rem;
        border-inline-start: 0.25rem solid var(--accent-dark);
        color: var(--gray-0);
    }

    .back-link:hover,
    .back-link:focus,
    .content :global(a:hover),
    .content :global(a:focus) {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    @media (min-width: 50em) {
        .header-main {
            grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.65fr);
            gap: 1.25rem 2rem;
            align-items: start;
        }

        .summary {
            justify-self: end;
            text-align: right;
        }

        .summary :global(.button-pill) {
            width: 100%;
            justify-content: center;
        }

        .content :global(blockquote) {
            font-size: var(--text-2xl);
        }
    }
</style>
