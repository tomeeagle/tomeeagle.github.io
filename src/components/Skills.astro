---
import Icon from './Icon.astro';
---

<section class="box skills">
	<div class="intro stack gap-2">
		<p class="eyebrow">Services</p>
		<h2>How I help ecommerce teams ship better storefronts</h2>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="storefront" color="var(--accent-regular)" size="2.5rem" gradient />
		<h3>Shopify Theme Delivery</h3>
		<p>Custom sections, component architecture, and Liquid implementation for high-performing Shopify themes.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="code" color="var(--accent-regular)" size="2.5rem" gradient />
		<h3>CRO and PDP UX Improvements</h3>
		<p>Conversion-focused product page, cart, and quick-add updates that reduce friction across desktop and mobile.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="terminal-window" color="var(--accent-regular)" size="2.5rem" gradient />
		<h3>Frontend QA, Performance and Support</h3>
		<p>Ongoing release support with accessibility, performance tuning, and bug fixing to keep storefronts reliable.</p>
	</div>
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: var(--radius-card);
		padding: 0;
		background: color-mix(in srgb, var(--gray-999) 86%, transparent);
		box-shadow: var(--shadow-sm);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.skills > div {
		padding: 1.25rem 1.1rem;
	}

	.skills > div + div {
		border-top: 1px solid color-mix(in srgb, var(--gray-800) 75%, transparent);
	}

	.intro {
		max-width: 60ch;
	}

	.eyebrow {
		color: var(--gray-400);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: var(--text-sm);
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills h3 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
		max-width: 40ch;
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 3rem;
			padding: 2.5rem;
		}

		.skills > div {
			padding: 0;
		}

		.skills > div + div {
			border-top: 0;
		}

		.intro {
			grid-column: 1 / -1;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
